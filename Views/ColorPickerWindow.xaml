<Window x:Class="OpenPen.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenPen color"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="14"
            Background="#FF23262E"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}">
                        <Path Data="{StaticResource IconPlus}" Stroke="#FF17181D" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Pick a color" Margin="9,0,0,0" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right" AutomationProperties.Name="Close color picker"
                        Click="Cancel_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconStroked}" Width="14" Height="14" />
                </Button>
            </Grid>

            <TextBlock Text="PRESETS" Style="{StaticResource SectionLabel}" Margin="0,16,0,9" />
            <WrapPanel x:Name="SwatchPanel" />

            <TextBlock Text="CUSTOM" Style="{StaticResource SectionLabel}" Margin="0,14,0,9" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Border x:Name="Preview" CornerRadius="11" Background="{StaticResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="Hex" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <TextBox x:Name="HexBox" AutomationProperties.Name="Hex color" Style="{StaticResource DarkTextBox}" Width="126" Height="40"
                                 HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12.5"
                                 TextChanged="HexBox_TextChanged" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="RedSlider" AutomationProperties.Name="Red" Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Rgb_Changed" />
                        <TextBlock x:Name="RedValue" Grid.Column="2" Text="255" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10.5" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="GreenSlider" AutomationProperties.Name="Green" Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Rgb_Changed" />
                        <TextBlock x:Name="GreenValue" Grid.Column="2" Text="122" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10.5" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="BlueSlider" AutomationProperties.Name="Blue" Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="255"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Rgb_Changed" />
                        <TextBlock x:Name="BlueValue" Grid.Column="2" Text="69" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="10.5" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button AutomationProperties.Name="Cancel" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button AutomationProperties.Name="Use color" Content="Use color" Style="{StaticResource AccentButton}" Click="Apply_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
