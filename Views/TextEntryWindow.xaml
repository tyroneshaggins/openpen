<Window x:Class="OpenPen.Views.TextEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add text"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="14"
            Background="#FF23262E"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ColorDot" Width="12" Height="12" CornerRadius="6" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Add text" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SizeLabel" Text="28 px" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" />
            </Grid>

            <TextBox x:Name="InputText" AutomationProperties.Name="Annotation text"
                     Style="{StaticResource DarkTextBox}"
                     Margin="0,12,0,0"
                     MinHeight="82"
                     MaxHeight="210"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     FontSize="17" />

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Enter to add  ·  Shift+Enter for a new line  ·  Esc to cancel"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10.5" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button AutomationProperties.Name="Cancel text" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button AutomationProperties.Name="Add text" Content="Add text" Style="{StaticResource AccentButton}" Click="Add_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
