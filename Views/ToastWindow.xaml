<Window x:Class="OpenPen.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenPen notification"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card"
            Margin="14"
            Background="#F223262E"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="15"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText"
                           Text="OpenPen"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText"
                           Text=""
                           Margin="0,3,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           LineHeight="16" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
