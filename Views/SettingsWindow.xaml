<Window x:Class="OpenPen.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenPen settings"
        Width="680"
        Height="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="14"
            Background="#FF20232A"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.52" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentBrush}">
                            <Path Data="{StaticResource IconNib}" Fill="#FFFFFFFF" Stretch="Uniform" Width="17" Height="17"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OpenPen settings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Local annotation for Windows" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Right" AutomationProperties.Name="Close settings"
                            Click="Close_Click" ToolTip="Close">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconStroked}" Width="15" Height="15" />
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,14,0">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
                    <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,4">
                        <StackPanel>
                            <DockPanel Height="46">
                                <CheckBox x:Name="StartupToggle" AutomationProperties.Name="Start with Windows" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" Click="StartupToggle_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                    <TextBlock Text="Launch OpenPen quietly when you sign in" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                </StackPanel>
                            </DockPanel>
                            <Border Height="1" Background="#14FFFFFF" />
                            <DockPanel Height="46">
                                <CheckBox x:Name="HotkeysToggle" AutomationProperties.Name="Global shortcuts" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                          VerticalAlignment="Center" Click="HotkeysToggle_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Global shortcuts" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                    <TextBlock Text="Control OpenPen from any app, even full screen" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="INK" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                    <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Fading ink" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                            <TextBlock Text="Marks fade away so you never have to stop and clear the screen."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,9" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="FadeOffButton" AutomationProperties.Name="Fading ink off" Content="Off" Tag="Off" Style="{StaticResource SegmentToggle}" Click="FadeMode_Click" />
                                <ToggleButton x:Name="FadeSlowButton" AutomationProperties.Name="Fading ink slow" Content="Slow · 20s" Tag="Slow" Style="{StaticResource SegmentToggle}" Click="FadeMode_Click" />
                                <ToggleButton x:Name="FadeMediumButton" AutomationProperties.Name="Fading ink medium" Content="Medium · 10s" Tag="Medium" Style="{StaticResource SegmentToggle}" Click="FadeMode_Click" />
                                <ToggleButton x:Name="FadeFastButton" AutomationProperties.Name="Fading ink fast" Content="Fast · 5s" Tag="Fast" Style="{StaticResource SegmentToggle}" Click="FadeMode_Click" />
                            </StackPanel>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,14" />

                            <TextBlock Text="Spotlight size" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                            <TextBlock Text="The bright circle that follows your cursor." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,9" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="SpotlightSmallButton" AutomationProperties.Name="Spotlight small" Content="Small" Tag="120" Style="{StaticResource SegmentToggle}" Click="SpotlightSize_Click" />
                                <ToggleButton x:Name="SpotlightMediumButton" AutomationProperties.Name="Spotlight medium" Content="Medium" Tag="170" Style="{StaticResource SegmentToggle}" Click="SpotlightSize_Click" />
                                <ToggleButton x:Name="SpotlightLargeButton" AutomationProperties.Name="Spotlight large" Content="Large" Tag="230" Style="{StaticResource SegmentToggle}" Click="SpotlightSize_Click" />
                            </StackPanel>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,14" />
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Clear all ink" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                    <TextBlock Text="Strokes are kept in memory only." Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                </StackPanel>
                                <Button Content="Clear ink" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                        HorizontalAlignment="Right" Click="ClearInk_Click" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TOOLBAR" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                    <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <DockPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Toolbar position" Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                <TextBlock Text="Snap it back above the taskbar in the centre of your main display."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                            </StackPanel>
                            <Button Content="Reset position" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Click="ResetToolbar_Click" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                    <TextBlock x:Name="HotkeyWarning" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}" FontSize="10.5" Margin="0,0,0,8" />
                    <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="HotkeyPanel" />
                    </ScrollViewer>
                    <TextBlock Text="Shortcuts are fixed in this build. They match Epic Pen's familiar Ctrl+Shift layout."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                    <Border Background="#0AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="OpenPen 1.0.0" Foreground="{StaticResource TextBrush}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="Free and open source under the MIT license."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                            <TextBlock Text="Everything you draw stays on this PC, in memory, until you clear it."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="20,0,16,0">
                <Button Content="Exit OpenPen" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Click="Exit_Click" Foreground="{StaticResource DangerBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+Shift+1 shows or hides ink"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Done" Style="{StaticResource AccentButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
